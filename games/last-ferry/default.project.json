{
  "name": "last-ferry",
  "emitLegacyScripts": false,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$path": "ReplicatedStorage",
      "$ignoreUnknownInstances": true
    },
    "ServerScriptService": {
      "$path": "ServerScriptService",
      "$ignoreUnknownInstances": true
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    }
  }
}
